# ============================================================
# Synopsys Design Compiler
# ============================================================

work/
synth/work/
default.svf
command.log
filenames.log

# NÃO ignorar reports, pois você quer subir:
# synth/reports/*
# synth/runs/*

# Ignorar apenas resultados pesados/intermediários da síntese
synth/results/*
synth/runs/*/results/*
*.ddc
*.svf

# Mantém pastas vazias versionadas
!synth/results/.gitkeep


# ============================================================
# Bibliotecas de tecnologia / libs proprietárias
# ============================================================

libs/*
synth/libs/*
*.db
*.lib
*.sldb
*.lef
*.tf
*.tluplus
*.map

# Mantém placeholders/README das pastas de libs
!libs/.gitkeep
!libs/README.md
!synth/libs/.gitkeep
!synth/libs/README.md
!synth/libs/COLOQUE_A_BIBLIOTECA_AQUI.txt


